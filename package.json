{
  "name": "web-game",
  "version": "0.1.22",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:design": "node design/check.mjs",
    "benchmark": "node scripts/benchmark.ts",
    "check:browser": "node scripts/browser.mjs",
    "check:languages": "node scripts/languages.mjs",
    "check:recovery": "node scripts/recovery.mjs",
    "check:resume": "node scripts/resume.mjs",
    "check:startup": "node scripts/startup.mjs",
    "check:title": "node scripts/title.mjs",
    "check:choice-pause": "node scripts/choice-pause.mjs",
    "check:controls": "node scripts/controls.mjs",
    "check:effects": "node scripts/effects.mjs",
    "check:presentation": "node scripts/presentation.mjs",
    "check:collapse": "node scripts/collapse.mjs",
    "check:ending": "node scripts/ending.mjs",
    "check:electric": "node scripts/electric.mjs",
    "check:barrier": "node scripts/orbit-barrier.mjs",
    "check:performance": "node scripts/performance.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "build": "tsc --noEmit && vite build",
    "build:art": "node scripts/art.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 8081 --strictPort",
    "check:balance": "node scripts/balance.ts",
    "check:beyond": "node scripts/beyond.ts",
    "check:beyond-browser": "node scripts/beyond-browser.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.9",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
