{
  "name": "web-game",
  "version": "0.1.65",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.ts",
    "check": "npm test && npm run check:design && npm run sim -- balance && npm run check:browser -- smoke choices late-game",
    "check:design": "node design/schema.ts",
    "sim": "node scripts/sim.ts",
    "check:browser": "node scripts/browser.mjs",
    "build": "tsc --noEmit && vite build",
    "build:art": "node scripts/art.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.9",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
