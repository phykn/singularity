{
  "name": "web-game",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:design": "node design/check.mjs",
    "benchmark": "node scripts/benchmark.ts",
    "check:browser": "node scripts/browser.mjs",
    "check:languages": "node scripts/languages.mjs",
    "check:resume": "node scripts/resume.mjs",
    "check:startup": "node scripts/startup.mjs",
    "check:performance": "node scripts/performance.mjs",
    "build": "tsc --noEmit && vite build",
    "build:art": "node scripts/art.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 8081 --strictPort",
    "check:balance": "node scripts/balance.ts"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "pixelarticons": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.9",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
